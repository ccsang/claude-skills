#!/usr/bin/env node

import { Command } from 'commander';
import chalk from 'chalk';
import ora from 'ora';
import fs from 'fs';
import { createRequire } from 'module';
const require = createRequire(import.meta.url);
const packageJson = require('../package.json');

import { downloadSubtitles, toSRT, toText } from '../src/index.js';

const program = new Command();

program
    .name('ydl-js')
    .description('Download YouTube subtitles')
    .version(packageJson.version)
    .argument('<url>', 'YouTube video URL or ID')
    .option('-l, --lang <lang>', 'Subtitle language', 'en')
    .option('-f, --format <format>', 'Output format (srt, json, txt)', 'srt')
    .option('-o, --output <file>', 'Output file path')
    .action(async (url, options) => {
        const spinner = ora('Fetching subtitles...').start();
        try {
            const videoId = extractVideoId(url);
            if (!videoId) {
                throw new Error('Invalid YouTube URL or ID');
            }

            const subtitles = await downloadSubtitles(videoId, options.lang);

            let outputData;
            if (options.format === 'json') {
                outputData = JSON.stringify(subtitles, null, 2);
            } else if (options.format === 'txt' || options.format === 'text') {
                outputData = toText(subtitles);
            } else {
                outputData = toSRT(subtitles);
            }

            if (options.output) {
                fs.writeFileSync(options.output, outputData);
                spinner.succeed(chalk.green(`Subtitles saved to ${options.output}`));
            } else {
                spinner.stop();
                console.log(outputData);
            }
        } catch (error) {
            spinner.fail(chalk.red(error.message));
            process.exit(1);
        }
    });

function extractVideoId(input) {
    // Remove shell-escape backslashes that can hide query params (e.g. \?v\=id)
    const sanitized = input.replace(/\\([?&#=])/g, '$1').trim();

    // If input matches standard video ID format (11 chars), return it
    if (/^[a-zA-Z0-9_-]{11}$/.test(sanitized)) {
        return sanitized;
    }

    try {
        const url = new URL(sanitized);
        if (url.hostname === 'youtu.be') {
            return url.pathname.slice(1);
        }
        if (url.hostname.includes('youtube.com')) {
            return url.searchParams.get('v');
        }
    } catch (e) {
        // Not a URL, and failed ID check
    }

    // Last-chance regex extraction from the sanitized string
    const match = sanitized.match(/v=([a-zA-Z0-9_-]{11})/);
    if (match) {
        return match[1];
    }
    return null;
}

program.parse();
