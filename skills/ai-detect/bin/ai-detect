#!/usr/bin/env node

import { Command } from 'commander';
import chalk from 'chalk';
import ora from 'ora';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { detectAI } from '../src/index.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
// Only try to read package.json if it exists (robustness)
const pkgPath = path.join(__dirname, '../package.json');
const version = fs.existsSync(pkgPath) ? JSON.parse(fs.readFileSync(pkgPath, 'utf-8')).version : '1.0.0';

const program = new Command();

program
    .name('ai-detect')
    .description('Detect if text is AI-generated using matrix.tencent.com')
    .version(version)
    .argument('<input>', 'File path or direct text string to analyze')
    .action(async (input) => {
        let text = input;
        
        // Check if input is a file
        if (fs.existsSync(input)) {
            try {
                text = fs.readFileSync(input, 'utf-8');
            } catch (e) {
                // Ignore, treat as string
            }
        }

        if (text.length < 10) {
            console.error(chalk.red('Error: Text is too short (min 10 chars).'));
            process.exit(1);
        }

        const spinner = ora('Detecting AI content...').start();
        try {
            const result = await detectAI(text);
            spinner.stop();
            console.log(chalk.bold('\nDetection Result:'));
            
            // Colorize result
            if (result.includes('AI') && !result.includes('可能性低')) {
                console.log(chalk.red(result));
            } else if (result.includes('人工') || result.includes('可能性低')) {
                console.log(chalk.green(result));
            } else {
                console.log(chalk.yellow(result));
            }
        } catch (error) {
            spinner.fail(chalk.red(`Detection failed: ${error.message}`));
            if (error.message.includes('Limit')) {
                console.log(chalk.yellow('Hint: You may have reached the daily free limit for this tool.'));
            }
            process.exit(1);
        }
    });

program.parse();
